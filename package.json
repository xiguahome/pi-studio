{
  "name": "@agegr/pi-studio",
  "version": "1.0.16",
  "description": "pi-studio — desktop interface for the pi coding agent",
  "homepage": "https://github.com/agegr/pi-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agegr/pi-studio.git"
  },
  "bugs": {
    "url": "https://github.com/agegr/pi-studio/issues"
  },
  "license": "MIT",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "patches",
    "scripts",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "postinstall": "patch-package && node scripts/patch-pi-tasks.mjs && node scripts/patch-pi-subagents.mjs && node scripts/patch-pi-mcp-adapter.mjs && node scripts/patch-pi-chrome-devtools.mjs && node scripts/patch-pi-plan-mode.mjs && node scripts/patch-pi-hermes-memory.mjs && node scripts/patch-app-builder-nsis.mjs",
    "dev": "next dev -H 127.0.0.1 -p 30141",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30141",
    "lint": "eslint .",
    "desktop": "electron .",
    "desktop:dev": "cross-env PI_DESKTOP_SERVER_URL=http://127.0.0.1:30141 electron .",
    "desktop:runtime": "node desktop/scripts/install-node-runtime.mjs",
    "desktop:dist": "npm run build && npm run desktop:runtime && node scripts/patch-app-builder-nsis.mjs && electron-builder && node scripts/gen-update-manifest.mjs",
    "test": "node --experimental-strip-types --test \"app/**/*.test.mjs\" \"components/**/*.test.mjs\" \"hooks/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"public/**/*.test.mjs\"",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.0",
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "js-yaml": "^5.2.3",
    "next": "16.2.12",
    "patch-package": "^8.0.1",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-simple-code-editor": "^0.14.1",
    "remark-frontmatter": "^5.0.0",
    "strip-json-comments": "^5.0.0",
    "undici": "8.5.0"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.6.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "cross-env": "^7.0.3",
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "postcss": "^8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  }
}
