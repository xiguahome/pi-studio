# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory

# desktop (electron)
/desktop/runtime/
/dist-desktop/
/.buildhome/

# agent tooling (ZCode)
.zcode/
.pi/
.pi-studio/tasks/
.reasonix/
.workbuddy/
reasonix.toml

# project-local MCP config — written by the editor/ZCode (shared-server),
# not by pi-studio. Ignore so it never enters version control.
.mcp.json
desktop/updater/bin/

# web download site (pi-studio.180wx.cn) — internal, not open-sourced
/web/

# local update-server config (real host, baked into installer via
# electron-builder extraResources) — never enters version control
/resources/update-config.local.json
